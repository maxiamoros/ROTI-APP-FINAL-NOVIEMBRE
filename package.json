{
  "name": "rotiseria-central",
  "version": "1.0.0",
  "description": "Sistema de gestión para Rotisería Central",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "nodemon api/index.js",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npx prisma generate --schema=./prisma/schema.prisma && cd frontend && npm run build",
    "vercel-build": "npx prisma generate --schema=./prisma/schema.prisma && cd frontend && npm run build",
    "postinstall": "npx prisma generate --schema=./prisma/schema.prisma",
    "prisma:generate": "npx prisma generate --schema=./prisma/schema.prisma",
    "prisma:db-push": "npx prisma db push --schema=./prisma/schema.prisma"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "bcryptjs": "^3.0.3",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "^11.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "swagger-ui-express": "^5.0.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^6.19.3"
  }
}
