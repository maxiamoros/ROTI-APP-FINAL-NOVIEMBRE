# -------------------------------------------------------------
# VARIABLES DE ENTORNO - ROTISERIA CENTRAL
# -------------------------------------------------------------

# Base de datos SQLite local (ver prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Autenticación JWT Backend (obligatoria en producción)
JWT_SECRET="tu_clave_secreta_jwt_super_segura"

# Google Gemini para el asistente RotiAI
GEMINI_API_KEY="tu_gemini_api_key"
GEMINI_MODEL="gemini-3.5-flash"

# Google OAuth: sin un Client ID real el login con Google queda deshabilitado
GOOGLE_CLIENT_ID="TU_GOOGLE_CLIENT_ID"

# Puerto del backend (debe coincidir con el proxy de Vite)
PORT=3001
RUN_LOCAL=true

# Intérprete de Python para el chat IA (por ejemplo el de backend/.venv)
PYTHON_EXEC="python3"
